{
  "id": "AzureIllusion-subs",
  "name": "AzureIllusion",
  "version": "1.1.4",
  "language": "typescript",
  "type": "plugin",
  "description": "Subtitles provider for Polish anime fan-made subtitles in Seanime.",
  "author": "Thalkas",
  "icon": "https://raw.githubusercontent.com/Thalkas/seanime-extensions/main/sea-azure/azureillusion-logo-v3.png",
  "website": "https://subs.azureillusion.ovh/account?tab=api",
  "readme": "https://subs.azureillusion.ovh/account?tab=api",
  "notes": "(bez zmian)",
  "lang": "pl",
  "userConfig": {
    "version": 2,
    "requiresConfig": true,
    "fields": [
      {
        "type": "text",
        "name": "apiKey",
        "label": "AzureIllusion API Key (opcjonalnie)",
        "default": ""
      },
      {
        "type": "text",
        "name": "fansubyKey",
        "label": "fansuby API Key, fsb_… (opcjonalnie)",
        "default": ""
      },
      {
        "type": "text",
        "name": "baseUrl",
        "label": "Base URL",
        "default": "https://sea-azure.thalkas.workers.dev"
      }
    ]
  },
  "payloadURI": "https://raw.githubusercontent.com/Thalkas/seanime-extensions/main/sea-azure/azureillusion.ts",
  "manifestURI": "https://raw.githubusercontent.com/Thalkas/seanime-extensions/main/sea-azure/azureillusion.json",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "playback",
        "system"
      ],
      "allow": {
        "readPaths": [],
        "writePaths": ["$TEMP/seanime-now-playing.json"],
        "networkAccess": {
          "allowedDomains": ["*"],
          "reasoning": "Fetch subtitles from AzureIllusion API."
        }
      }
    }
  }
}
