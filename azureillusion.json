{
  "id": "AzureIllusion-subs",
  "name": "AzureIllusion",
  "version": "1.0.20",
  "language": "typescript",
  "type": "plugin",
  "description": "Subtitles provider for Polish anime fan-made subtitles in Seanime.",
  "author": "Thalkas, skoruppa",
  "icon": "https://raw.githubusercontent.com/Thalkas/sea-azure/main/azureillusion-logo-v3.png",
  "website": "https://subs.azureillusion.ovh/account?tab=api",
  "readme": "https://subs.azureillusion.ovh/account?tab=api",
  "lang": "pl",
  "userConfig": {
    "version": 1,
    "requiresConfig": true,
    "fields": [
      {
        "type": "text",
        "name": "apiKey",
        "label": "AzureIllusion API Key",
        "default": ""
      },
      {
        "type": "text",
        "name": "baseUrl",
        "label": "Base URL",
        "default": "https://azureillusion-nuvio-addon.skoruppa.workers.dev"
      }
    ]
  },
  "payloadURI": "https://raw.githubusercontent.com/Thalkas/sea-azure/main/azureillusion.ts",
  "manifestURI": "https://raw.githubusercontent.com/Thalkas/sea-azure/main/azureillusion.json",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "playback"
      ],
      "allow": {
        "networkAccess": {
          "allowedDomains": ["*"],
          "reasoning": "Fetch subtitles from AzureIllusion API"
        }
      }
    }
  }
}
